# CQ06: ロットLは「要注意」か。判定理由を経路で示せ (R01, R02, R03)
# path: lot <- Evidence（urn:src:evidence）-> rule / 根拠事実
#
# 判定は queries/evidence_r0*.rq が urn:src:evidence に書き戻した ex:Evidence をそのまま読む。
# アプリの判定・根拠経路・説明文も同じ Evidence を元にするため、結果テーブルと画面の判定は常に一致する。
# 1 行 = 1 Evidence（該当ルール）。行が無ければどのルールにも該当しない。
# 判定不能（R02 で保全記録が無いなど）は conclusion「判定不能」と undeterminedReason で返す。
# 結論の重い順（出荷保留 > 要注意 > 判定不能）の並べ替えはアプリ層で行う。
PREFIX ex:   <http://example.org/kg/ontology#>
PREFIX data: <http://example.org/kg/data/>

SELECT ?lot ?ruleId ?ruleName ?conclusion ?observedValue ?numerator ?denominator
       ?threshold ?thresholdUnit ?comparison ?undeterminedReason ?evidence
       (GROUP_CONCAT(DISTINCT STR(?fact); separator=" ") AS ?facts)
WHERE {
    VALUES ?lot { <http://example.org/kg/data/lot/L0003> }  # 対象ロットはアプリ層で差し替える
    GRAPH <urn:src:evidence> {
        ?evidence ex:evidenceSubject ?lot ;
                  ex:evidenceRule ?rule ;
                  ex:conclusion ?conclusion ;
                  ex:appliedThreshold ?threshold ;
                  ex:evidenceFact ?fact .
        OPTIONAL { ?evidence ex:observedValue ?observedValue . }
        OPTIONAL { ?evidence ex:observedNumerator ?numerator . }
        OPTIONAL { ?evidence ex:observedDenominator ?denominator . }
        OPTIONAL { ?evidence ex:undeterminedReason ?undeterminedReason . }
    }
    ?rule ex:rule_id ?ruleId ; ex:rule_name ?ruleName .
    OPTIONAL { ?rule ex:comparison ?comparison . }
    OPTIONAL { ?rule ex:threshold_unit ?thresholdUnit . }
}
GROUP BY ?lot ?ruleId ?ruleName ?conclusion ?observedValue ?numerator ?denominator
         ?threshold ?thresholdUnit ?comparison ?undeterminedReason ?evidence
ORDER BY ?ruleId
