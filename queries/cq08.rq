# CQ08: サプライヤーSの代替候補は？根拠付き (R04: 低評価サプライヤー, R05: 代替サプライヤー条件)
# path: 現行サプライヤー <- 部品 -> 規格 <- 代替部品 -> 代替サプライヤー
#
# 判定は queries/evidence_r05_alternative.rq が urn:src:evidence に書き戻した ex:Evidence をそのまま読む。
# 対象は部品（R04 に該当するサプライヤーが供給する部品）。1 行 = 1 代替候補（代替部品 × 代替サプライヤー）。
# 行が無ければ、その部品は R04 非該当か、R05 を満たす代替が無い。
# 推奨の強さ（順位）は付けない。並びは代替部品・代替サプライヤーの ID 順。
PREFIX ex:   <http://example.org/kg/ontology#>
PREFIX data: <http://example.org/kg/data/>

SELECT ?part ?ruleId ?ruleName ?conclusion ?curSupplier ?spec ?altPart ?altSupplier
       ?observedValue ?numerator ?denominator ?threshold ?thresholdUnit ?comparison ?undeterminedReason ?evidence
WHERE {
    VALUES ?part { <http://example.org/kg/data/part/PT013> }  # 対象部品はアプリ層で差し替える
    GRAPH <urn:src:evidence> {
        ?evidence ex:evidenceSubject ?part ;
                  ex:evidenceRule ?rule ;
                  ex:conclusion ?conclusion ;
                  ex:appliedThreshold ?threshold ;
                  ex:alternativePart ?altPart ;
                  ex:alternativeSupplier ?altSupplier ;
                  ex:evidenceFact ?curSupplier , ?spec .
        OPTIONAL { ?evidence ex:observedValue ?observedValue . }
        OPTIONAL { ?evidence ex:observedNumerator ?numerator . }
        OPTIONAL { ?evidence ex:observedDenominator ?denominator . }
        OPTIONAL { ?evidence ex:undeterminedReason ?undeterminedReason . }
    }
    ?curSupplier a ex:Supplier . FILTER(?curSupplier != ?altSupplier)
    ?spec a ex:Spec .
    ?rule ex:rule_id ?ruleId ; ex:rule_name ?ruleName .
    OPTIONAL { ?rule ex:comparison ?comparison . }
    OPTIONAL { ?rule ex:threshold_unit ?thresholdUnit . }
}
ORDER BY ?altPart ?altSupplier
