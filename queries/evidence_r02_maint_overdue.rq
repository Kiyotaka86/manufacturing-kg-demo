# R02: 最終保全日から保全間隔（maint_interval_days）を超えた設備で製造したロットを要注意と判定する。
#
# 根拠経路: ロット ← 工程実績（opLot）→ 設備（opEquipment）← 最終保全（maintainedEquipment）
#   「最終保全」はロット製造開始日（start_date）以前で最も新しい保全。全期間の最新保全ではない
#   （判定時点で知り得なかった保全を根拠にしないため）。
#   分子 = 最終保全日からロット製造開始日までの日数、分母 = 設備の保全間隔。
#   閾値は Rule ではなく設備ごとの maint_interval_days（rules シートの R02 は threshold が空欄）。
#
# 製造開始日以前に保全記録が1件もない設備で作ったロットは日数を計算できないため判定しない（Evidence なし）。
#
# 実行前に CLEAR SILENT GRAPH <urn:src:evidence> が必要（src/evidence.py がまとめて行う）。
# USING は、データが名前付きグラフにあるため必須。
PREFIX ex:   <http://example.org/kg/ontology#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX fn:   <http://www.w3.org/2005/xpath-functions#>

INSERT {
  GRAPH <urn:src:evidence> {
    ?ev a ex:Evidence ;
        ex:evidenceSubject ?lot ;
        ex:evidenceRule    ?rule ;
        ex:evidenceFact    ?op , ?eq , ?maint ;
        ex:observedValue   ?days ;
        ex:observedNumerator   ?days ;
        ex:observedDenominator ?interval ;
        ex:appliedThreshold ?interval ;
        ex:conclusion      ?conclusion ;
        ex:evaluatedAt     ?now .
  }
}
USING <urn:x-arq:UnionGraph>
WHERE {
  ?rule ex:rule_id "R02" ; ex:conclusion ?conclusion .

  # 1. ロットごとに、製造開始日以前で最も新しい保全日を求める
  {
    SELECT ?lot ?op ?eq ?start (MAX(?md) AS ?lastDate)
    WHERE {
      ?op ex:opLot ?lot ; ex:opEquipment ?eq .
      ?lot ex:start_date ?start .
      ?m ex:maintainedEquipment ?eq ; ex:maint_date ?md .
      FILTER(?md <= ?start)
    }
    GROUP BY ?lot ?op ?eq ?start
  }
  ?maint ex:maintainedEquipment ?eq ; ex:maint_date ?lastDate .

  # 2. 経過日数と設備の保全間隔を比較する
  ?eq ex:maint_interval_days ?interval .
  BIND(fn:days-from-duration(?start - ?lastDate) AS ?days)
  FILTER(?days > ?interval)

  BIND(NOW() AS ?now)
  BIND(IRI(CONCAT("http://example.org/kg/data/evidence/R02-",
                  STRAFTER(STR(?lot), "/lot/"))) AS ?ev)
}
