@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ex:   <http://example.org/kg/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:PartShape a sh:NodeShape ;
    sh:targetClass ex:Part ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
    ] .
