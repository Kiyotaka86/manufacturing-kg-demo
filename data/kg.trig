<urn:src:rules> {
    <http://example.org/kg/data/rule/R01> a ns1:Rule ;
        ns1:conclusion "要注意" ;
        ns1:description "同一サプライヤーの部品を使った直近3ロットの不良率が閾値を超える場合、当該部品を使うロットを要注意と判定する" ;
        ns1:rule_id "R01" ;
        ns1:rule_name "サプライヤー不良率" ;
        ns1:target_class "Lot" ;
        ns1:threshold 0.05 ;
        ns1:threshold_unit "ratio" .

    <http://example.org/kg/data/rule/R02> a ns1:Rule ;
        ns1:conclusion "要注意" ;
        ns1:description "最終保全日から保全間隔（maint_interval_days）を超えた設備で製造したロットを要注意と判定する" ;
        ns1:rule_id "R02" ;
        ns1:rule_name "保全間隔超過" ;
        ns1:target_class "Lot" ;
        ns1:threshold_unit "days(equipment)" .

    <http://example.org/kg/data/rule/R03> a ns1:Rule ;
        ns1:conclusion "出荷保留" ;
        ns1:description "検査結果にNGが1件以上あるロットは出荷保留とする" ;
        ns1:rule_id "R03" ;
        ns1:rule_name "検査NG" ;
        ns1:target_class "Lot" ;
        ns1:threshold 1 ;
        ns1:threshold_unit "count" .

    <http://example.org/kg/data/rule/R04> a ns1:Rule ;
        ns1:conclusion "代替検討" ;
        ns1:description "評価（rating）が閾値未満のサプライヤーが供給する部品は代替候補検討の対象とする" ;
        ns1:rule_id "R04" ;
        ns1:rule_name "低評価サプライヤー" ;
        ns1:target_class "Part" ;
        ns1:threshold 3 ;
        ns1:threshold_unit "rating" .

    <http://example.org/kg/data/rule/R05> a ns1:Rule ;
        ns1:conclusion "代替候補" ;
        ns1:description "代替サプライヤーは同一規格（spec）の部品を供給し、直近の不良率が閾値以下であること" ;
        ns1:rule_id "R05" ;
        ns1:rule_name "代替サプライヤー条件" ;
        ns1:target_class "Supplier" ;
        ns1:threshold 0.03 ;
        ns1:threshold_unit "ratio" .

    <http://example.org/kg/data/rule/R06> a ns1:Rule ;
        ns1:conclusion "遅延リスク" ;
        ns1:description "納期までの残日数が製造リードタイム未満で、対応ロットが未完了の場合は遅延リスクと判定する" ;
        ns1:rule_id "R06" ;
        ns1:rule_name "納期遅延リスク" ;
        ns1:target_class "Order" ;
        ns1:threshold 5 ;
        ns1:threshold_unit "days" .

    <http://example.org/kg/data/rule/R07> a ns1:Rule ;
        ns1:conclusion "設備起因疑い" ;
        ns1:description "同一不良種別が同一設備で30日以内に2件以上発生した場合、設備起因を疑う" ;
        ns1:rule_id "R07" ;
        ns1:rule_name "設備起因疑い" ;
        ns1:target_class "Equipment" ;
        ns1:threshold 2 ;
        ns1:threshold_unit "count/30days" .

    <http://example.org/kg/data/rule/R08> a ns1:Rule ;
        ns1:conclusion "影響範囲" ;
        ns1:description "重大度Highのクレームは、同一ロットを含む全出荷先を影響範囲とする" ;
        ns1:rule_id "R08" ;
        ns1:rule_name "影響範囲拡大" ;
        ns1:target_class "Defect" ;
        ns1:threshold "High" ;
        ns1:threshold_unit "severity" .
}

